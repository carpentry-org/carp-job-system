(load "carp-job-system.carp")

(Project.config "title" "carp-job-system")
(Project.config "docs-directory" "./docs/")
(Project.config "docs-logo" "")
(Project.config "docs-url" "https://github.com/carpentry-org/carp-job-system")
(Project.config "docs-styling" "../style.css")
(Project.config "docs-prelude" "A POSIX-threads thread pool for Carp, and a set
of parallel collection operators built on top of it.

```
(load \"git@github.com:carpentry-org/carp-job-system@master\")
```

### The pool
- [`JobSystem`](./JobSystem.html) — pool lifecycle, job submission, and waiting
- [`Future`](./Future.html) — a handle to a result that is not ready yet

### Parallel operators
- [`Rayon`](./Rayon.html) — fork-join over a range
- [`Par`](./Par.html) — parallel `map`, `filter`, `reduce`, `find` and friends
  over arrays, in the shape rust's rayon uses. the SIMD paths come from
  [carp-math](https://github.com/carpentry-org/carp-math).

The C side lives in `jobs.h` and is pulled in with `relative-include`, so it
travels with the library.")

(save-docs JobSystem Future Rayon Par)
; Carp's save-docs hardcodes the index filename as <title>_index.html.
; Rename to docs/index.html.
(defn main []
  (System.system "mv ./docs/carp-job-system_index.html ./docs/index.html"))
