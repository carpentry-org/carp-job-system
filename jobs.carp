(register-type ThreadPool "thread_pool_t")
(register-type JobHandle "job_handle_t")

(relative-include "jobs.h")

(defmodule JobSystem
  ;; Pool Lifecycle
  (deftemplate create-pool (Fn [Int] (Ptr ThreadPool))
    "thread_pool_t* $NAME(int num_threads)"
    "$DECL { return thread_pool_create(num_threads); }")

  (deftemplate destroy-pool (Fn [(Ptr ThreadPool)] ())
    "void $NAME(thread_pool_t *pool)"
    "$DECL { thread_pool_destroy(pool); }")

  ;; Handle Lifecycle
  (deftemplate create-handle (Fn [Int] (Ptr JobHandle))
    "job_handle_t* $NAME(int count)"
    "$DECL { return job_handle_create(count); }")

  (deftemplate complete? (Fn [(Ptr JobHandle)] Bool)
    "bool $NAME(job_handle_t *handle)"
    "$DECL { return job_handle_complete(handle); }")

  (deftemplate wait (Fn [(Ptr JobHandle)] ())
    "void $NAME(job_handle_t *handle)"
    "$DECL { job_handle_wait(handle); }")

  (deftemplate destroy-handle (Fn [(Ptr JobHandle)] ())
    "void $NAME(job_handle_t *handle)"
    "$DECL { job_handle_destroy(handle); }")

  ;; Raw Job Dispatch (extracting function pointer from Carp Lambda)
  (deftemplate submit-raw! (Fn [(Ptr ThreadPool) (Fn [(Ptr ())] ()) (Ptr ()) (Ptr JobHandle)] ())
    "void $NAME(thread_pool_t *pool, Lambda work, void *data, job_handle_t *handle)"
    "$DECL {
        job_t job;
        job.work = (job_work_fn)work.callback;
        job.data = data;
        job.handle = handle;
        job_queue_push(pool->queue, job);
    }")
)
