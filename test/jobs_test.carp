(load "Test.carp")
(use Test)
(load "jobs.carp")
(use JobSystem)

(defn pointer-cast [p] (Pointer.from-long (Pointer.to-long p)))

(defn set-index [idx data-ptr]
  (let [p (the (Ptr Float) (pointer-cast data-ptr))]
    (Pointer.set (Pointer.add p (Long.from-int idx))
                 (Float.from-int (+ idx 100)))))

(deftest jobs-test
  (let [state (Test.State.init 0 0)
        pool (JobSystem.create-pool 4)]
    (do
      ;; 1. Verify High-Level async/await Macros
      (let [t1 (async pool (* 2f 2f))
            t2 (async pool (* 3f 3f))
            v1 (await t1)
            v2 (await t2)]
        (do
          (set! state
                (assert-equal &state 4f v1 "async/await Task 1 (2*2) = 4.0"))
          (set! state
                (assert-equal &state 9f v2 "async/await Task 2 (3*3) = 9.0"))))

      ;; 2. Verify High-Level Parallel-For loop driver
      (let [arr [0f 0f 0f 0f 0f 0f 0f 0f 0f 0f]
            p-arr (Array.unsafe-raw &arr)]
        (do
          (JobSystem.parallel-for! pool 10 2 set-index (pointer-cast p-arr))
          (set! state
                (assert-equal &state
                  100f
                  @(Array.unsafe-nth &arr 0)
                  "parallel-for idx 0 is 100.0"))
          (set! state
                (assert-equal &state
                  105f
                  @(Array.unsafe-nth &arr 5)
                  "parallel-for idx 5 is 105.0"))
          (set! state
                (assert-equal &state
                  109f
                  @(Array.unsafe-nth &arr 9)
                  "parallel-for idx 9 is 109.0"))))

      (JobSystem.destroy-pool pool)
      state)))
